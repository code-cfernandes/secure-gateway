# No Portainer, cadastre estas variáveis em "Environment variables" da stack.

# Token do túnel (Zero Trust > Networks > Tunnels > seu túnel > comando de instalação)
CLOUDFLARE_TUNNEL_TOKEN=

# Endereço do Ollama visto de dentro da rede services-net (nome do container:porta)
OLLAMA_UPSTREAM=ollama:11434

# Rate limit (sintaxe do nginx: Nr/s ou Nr/m)
RATE_LIMIT_PER_CLIENT=10r/s
RATE_LIMIT_PER_IP=20r/s

# Tamanho máximo do corpo (prompts com imagens podem ser grandes; limite do plano Free da Cloudflare: 100m)
MAX_BODY_SIZE=50m

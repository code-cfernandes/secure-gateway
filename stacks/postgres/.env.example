# No Portainer, cadastre estas variáveis em "Environment variables" da stack.

# Superusuário: só para manutenção (backup, extensões). Não use em aplicações nem no pgAdmin.
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=

# Usuário e banco do dia a dia: dono do banco, cria/trunca/apaga tabelas, sem superpoderes.
# Lidos só na PRIMEIRA inicialização (volume vazio).
APP_DB_NAME=app
APP_DB_USER=app
APP_DB_PASSWORD=

# Login do pgAdmin (MFA por app autenticador é exigido no primeiro acesso)
PGADMIN_EMAIL=
PGADMIN_PASSWORD=
